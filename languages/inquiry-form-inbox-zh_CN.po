#. translators: Placeholders must be preserved.
#: includes/trait-ifi-i18n.php:188
#, php-format
msgid "A code filter (ifi_honeypot_field) is overriding this setting: the form must post %s. The value above takes effect again once that filter is removed."
msgstr "代码里注册了 ifi_honeypot_field 过滤器，实际生效的字段名是 %s；移除该过滤器之前，上面填的值不会生效。"

#: includes/trait-ifi-i18n.php:189
msgid "Content rules"
msgstr "内容规则"

#: includes/trait-ifi-i18n.php:191
msgid "Blocked keywords"
msgstr "屏蔽关键字"

#: includes/trait-ifi-i18n.php:192
msgid "One per line. Case-insensitive and matched anywhere in the text, so prefer phrases over short words."
msgstr "每行一个。不区分大小写，可匹配文本中的任意位置；建议用短语，少用短词。"

#: includes/trait-ifi-i18n.php:193
msgid "Blocked email domains"
msgstr "屏蔽邮箱域名"

#: includes/trait-ifi-i18n.php:194
msgid "One per line, e.g. example.com. Subdomains are covered too."
msgstr "每行一个，例如 example.com；子域名同样拦。"

#: includes/trait-ifi-i18n.php:195
msgid "Maximum links"
msgstr "链接上限"

#: includes/trait-ifi-i18n.php:196
msgid "Counts http://, https:// and www. links across all text fields. 0 = no limit."
msgstr "统计所有文本字段里的 http://、https:// 与 www. 链接。0 = 不限。"

#: includes/trait-ifi-i18n.php:198
msgid "Hard blocks and duplicate detection."
msgstr "硬性拦截与重复检测。"

#: includes/trait-ifi-i18n.php:201
msgid "Blocked IP addresses"
msgstr "屏蔽 IP 地址"

#: includes/trait-ifi-i18n.php:202
msgid "One per line: 203.0.113.10, 2001:db8::1, or a range like 203.0.113.0/24. Matching requests are dropped on arrival and are not recorded."
msgstr "每行一个：203.0.113.10、2001:db8::1，或 203.0.113.0/24 这样的网段。命中的请求到达时即丢弃，不留记录。"

#: includes/trait-ifi-i18n.php:203
msgid "Duplicate window"
msgstr "重复提交窗口"

#: includes/trait-ifi-i18n.php:204
msgid "Blocks the same message from the same email again inside this window. 0 = off."
msgstr "窗口内同一邮箱再发同样的内容会被拦下。0 = 关闭。"

#: includes/trait-ifi-i18n.php:209
msgid "minutes"
msgstr "分钟"

#: includes/trait-ifi-i18n.php:210
