msgid "Inquiry Form Inbox for Headless WordPress"
msgstr "Inquiry Form Inbox for Headless WordPress"

#. Description of the plugin
#: inquiry-form-inbox.php
msgid "Connect any frontend. Keep every inquiry in one place."
msgstr ""

#. Author of the plugin
#: inquiry-form-inbox.php
